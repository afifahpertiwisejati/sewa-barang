# TiDB Cloud MySQL Configuration (SewaIn+)
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=sewain_db
# Optional: path to local CA certificate (leave empty to use Node.js system root CAs)
TIDB_CA_PATH=

# Session signing secret
SEWAIN_SESSION_SECRET=sewain-boutique-secret-key-2026
